{
  "name": "SMRA · Sudan Master Review Academy",
  "short_name": "SMRA",
  "description": "اشرح لي: منصة تعليمية متكاملة لطلبة الكليات الصحية في السودان: كورسات، محاضرات، مكتبة، فعاليات ومجتمع.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#e7f3f9",
  "theme_color": "#086981",
  "icons": [
    {
      "src": "icon-192.png?v=181",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png?v=181",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "application/ogg",
            ".mp3",
            ".m4a",
            ".ogg",
            ".oga",
            ".opus",
            ".aac",
            ".wav"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Surgery Master Review",
      "short_name": "Surgery",
      "url": "./#book/surgery",
      "icons": [
        {
          "src": "img/apps/surgery-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pediatrics Master Review",
      "short_name": "Pediatrics",
      "url": "./#book/pediatrics",
      "icons": [
        {
          "src": "img/apps/pediatrics-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Obstetrics Master Review",
      "short_name": "Obstetrics",
      "url": "./#book/obstetrics",
      "icons": [
        {
          "src": "img/apps/obstetrics-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "مكتبتي",
      "short_name": "المكتبة",
      "url": "./#library",
      "icons": [
        {
          "src": "icon-192.png?v=181",
